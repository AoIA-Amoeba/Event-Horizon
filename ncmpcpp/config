# ncmpcpp - Black Hole Rice

ncmpcpp_directory = ~/.config/ncmpcpp
lyrics_directory = ~/.lyrics

# Visualizer
visualizer_data_source = /tmp/mpd.fifo
visualizer_output_name = visualizer
visualizer_in_stereo = yes
visualizer_type = spectrum
visualizer_look = ●▮
visualizer_color = 8fc4ff, cfe6ff, ff8a4c

# Progress bar
progressbar_look = ─╼─
progressbar_elapsed_color = 8a92a8
progressbar_color = 8fc4ff

# Song format
song_list_format = "{$4%a - $9}{$5%t$9}|{$5%f$9}$R{$3%l$9}"
song_status_format = "$b{$4%a$9} {$2%t$9}"
song_library_format = "{%n - }{%t}|{%f}"
media_library_primary_tag = album_artist
media_library_albums_split_by_date = no

# Colors
colors_enabled = yes
empty_tag_color = 8a92a8
header_window_color = 8fc4ff
volume_color = 8fc4ff
state_line_color = 8a92a8
state_flags_color = 8fc4ff
main_window_color = dfe6f5
color1 = 8fc4ff
color2 = ff8a4c
current_item_prefix = "$b"
current_item_suffix = "$/b"
current_item_color = cfe6ff
statusbar_color = dfe6f5
alternative_ui_separator_color = 8a92a8
window_border_color = 8fc4ff
active_window_border = 8fc4ff

# Browser
browser_playlist_prefix = "$2playlist$9 "
browser_display_mode = columns
search_engine_display_mode = columns
playlist_display_mode = columns
media_library_display_mode = columns

# Misc
playlist_disable_highlight_delay = 5
autocenter_mode = yes
centered_cursor = no
user_interface = classic
locked_screen_width_part = 50
ask_for_locked_screen_width_part = no
display_bitrate = yes
external_editor = $EDITOR
main_window_color = white
startup_screen = playlist
startup_slave_screen = 
default_find_mode = wrapped
default_tag_editor_pattern = %n - %t
header_visibility = yes
statusbar_visibility = yes
titles_visibility = yes
enable_window_title = yes
pathlist_separators = " / "
custom_screen_title = 
custom_statusbar_title = 
mouse_support = yes
mouse_list_scroll_whole_page = no
lines_scrolled = 2
message_delay_time = 4
playlist_shorten_total_times = yes
playlist_separators = , |
show_hidden_files_in_browser = yes
display_volume_level = yes
ignore_leading_the = yes
mouse_support = yes
mouse_list_scroll_whole_page = no
lines_scrolled = 2
message_delay_time = 4
playlist_shorten_total_times = yes
playlist_separators = , |
show_hidden_files_in_browser = yes
display_volume_level = yes
ignore_leading_the = yes
block_search_constrain = yes
search_engine_default_search_mode = 2
media_library_sort_by_mtime = no
tag_editor_extended_pattern = no
set_window_title = yes
allow_for_physical_item_deletion = no
visualizer_fifo_path = /tmp/mpd.fifo
visualizer_sync_interval = 30
system_encoding = utf8
execute_on_song_change = notify-send "Now playing" "$(mpc current)"
